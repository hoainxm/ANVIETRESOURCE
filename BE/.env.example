# Backend-only settings. Never put provider keys, passwords, or database URLs in FE/.
APP_ENV=development
HOST=0.0.0.0
DATABASE_URL=
SECRET_KEY=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-luna
# Browser origins allowed to call the API; this does not start a server on these ports.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000,http://192.168.1.149:5500
# Comma-separated client subnets (CIDR); required for non-loopback development access.
# ALLOWED_CLIENT_NETWORKS=192.168.1.0/24
# LOCAL_ONLY=false
# SESSION_COOKIE_SECURE=false
